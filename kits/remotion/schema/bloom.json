{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "couple": {
      "type": "object",
      "properties": {
        "groom": {
          "type": "string",
          "description": "新郎姓名"
        },
        "bride": {
          "type": "string",
          "description": "新娘姓名"
        },
        "groomEn": {
          "type": "string",
          "description": "新郎英文名或拼音"
        },
        "brideEn": {
          "type": "string",
          "description": "新娘英文名或拼音"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "婚礼日期"
        },
        "tagline": {
          "type": "string",
          "description": "主标题"
        }
      },
      "required": [
        "groom",
        "bride",
        "groomEn",
        "brideEn",
        "date",
        "tagline"
      ]
    },
    "photos": {
      "type": "object",
      "properties": {
        "homeGroom": {
          "type": "string",
          "minLength": 1
        },
        "homeBride": {
          "type": "string",
          "minLength": 1
        },
        "kidGroom": {
          "type": "string",
          "minLength": 1
        },
        "kidBride": {
          "type": "string",
          "minLength": 1
        },
        "parents": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wing": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "growing": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parentsThanks": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "firstMeet": {
          "type": "string",
          "minLength": 1
        },
        "meetGroom": {
          "type": "string",
          "minLength": 1
        },
        "meetBride": {
          "type": "string",
          "minLength": 1
        },
        "dating": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pets": {
          "type": "string",
          "minLength": 1
        },
        "memories": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "travel": {
          "minItems": 2,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ritual": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposal": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "engagement": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wedding": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "homeGroom",
        "homeBride",
        "kidGroom",
        "kidBride",
        "parents",
        "wing",
        "growing",
        "parentsThanks",
        "firstMeet",
        "meetGroom",
        "meetBride",
        "dating",
        "pets",
        "memories",
        "travel",
        "ritual",
        "proposal",
        "engagement",
        "license",
        "wedding"
      ]
    },
    "copy": {
      "type": "object",
      "properties": {
        "prologueSuffix": {
          "type": "string",
          "description": "片头 · 我们的故事即将开始"
        },
        "bornTitle": {
          "type": "string",
          "description": "出生页 · 顶部标题"
        },
        "cityGroom": {
          "type": "string",
          "description": "新郎家乡城市名"
        },
        "cityBride": {
          "type": "string",
          "description": "新娘家乡城市名"
        },
        "yearGroom": {
          "type": "string",
          "description": "新郎出生年份"
        },
        "yearBride": {
          "type": "string",
          "description": "新娘出生年份"
        },
        "parentsTitle1": {
          "type": "string",
          "description": "感恩页 · 第一行粉色大字"
        },
        "parentsTitle2": {
          "type": "string",
          "description": "感恩页 · 第二行黄色重点"
        },
        "wingTitle": {
          "type": "string",
          "description": "呵护页 · 顶部白色文字"
        },
        "growingTitle1": {
          "type": "string",
          "description": "成长页 · 顶部粉色文字"
        },
        "growingTitle2": {
          "type": "string",
          "description": "成长页 · 底部黄色文字"
        },
        "thanksP1": {
          "type": "string",
          "description": "感谢父母 · 第一行"
        },
        "thanksP2": {
          "type": "string",
          "description": "感谢父母 · 第二行"
        },
        "meetYear": {
          "type": "string",
          "description": "相识页 · 打字年份"
        },
        "meetTitle": {
          "type": "string",
          "description": "相识页 · 主文案"
        },
        "datingDate": {
          "type": "string",
          "description": "恋爱定情日"
        },
        "datingDays": {
          "type": "string",
          "description": "携手同行天数"
        },
        "memoriesPrefix": {
          "type": "string",
          "description": "记忆章节 · 前缀文字"
        },
        "memoryTag1": {
          "type": "string",
          "description": "记忆打卡 1"
        },
        "memoryTag2": {
          "type": "string",
          "description": "记忆打卡 2"
        },
        "memoryTag3": {
          "type": "string",
          "description": "记忆打卡 3"
        },
        "travelLeft": {
          "type": "string",
          "description": "旅行章节 · 左侧竖排"
        },
        "travelRight": {
          "type": "string",
          "description": "旅行章节 · 右侧竖排"
        },
        "travel1": {
          "type": "string",
          "description": "旅行站点 1"
        },
        "travel2": {
          "type": "string",
          "description": "旅行站点 2"
        },
        "travel3": {
          "type": "string",
          "description": "旅行站点 3"
        },
        "travel4": {
          "type": "string",
          "description": "旅行站点 4"
        },
        "travel5": {
          "type": "string",
          "description": "旅行站点 5"
        },
        "travel6": {
          "type": "string",
          "description": "旅行站点 6"
        },
        "ritualL1": {
          "type": "string",
          "description": "仪式感 · 第一行"
        },
        "ritualL3": {
          "type": "string",
          "description": "仪式感 · 第三行"
        },
        "poem1": {
          "type": "string",
          "description": "四季感悟 · 第一行"
        },
        "poem2": {
          "type": "string",
          "description": "四季感悟 · 第二行"
        },
        "poem3": {
          "type": "string",
          "description": "四季感悟 · 第三行"
        },
        "poem4": {
          "type": "string",
          "description": "四季感悟 · 第四行"
        },
        "proposalTag": {
          "type": "string",
          "description": "求婚标签"
        },
        "engagementTag": {
          "type": "string",
          "description": "订婚标签"
        },
        "licenseDate": {
          "type": "string",
          "description": "领证日期"
        },
        "licenseTitle": {
          "type": "string",
          "description": "领证文案"
        },
        "thanksGuests": {
          "type": "string",
          "description": "结尾致谢文案"
        },
        "finaleL1": {
          "type": "string",
          "description": "尾声聚光灯 · 第一行"
        },
        "finaleL2": {
          "type": "string",
          "description": "尾声聚光灯 · 第二行"
        }
      },
      "required": [
        "prologueSuffix",
        "bornTitle",
        "cityGroom",
        "cityBride",
        "yearGroom",
        "yearBride",
        "parentsTitle1",
        "parentsTitle2",
        "wingTitle",
        "growingTitle1",
        "growingTitle2",
        "thanksP1",
        "thanksP2",
        "meetYear",
        "meetTitle",
        "datingDate",
        "datingDays",
        "memoriesPrefix",
        "memoryTag1",
        "memoryTag2",
        "memoryTag3",
        "travelLeft",
        "travelRight",
        "travel1",
        "travel2",
        "travel3",
        "travel4",
        "travel5",
        "travel6",
        "ritualL1",
        "ritualL3",
        "poem1",
        "poem2",
        "poem3",
        "poem4",
        "proposalTag",
        "engagementTag",
        "licenseDate",
        "licenseTitle",
        "thanksGuests",
        "finaleL1",
        "finaleL2"
      ]
    },
    "music": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "description": "public/ 下的音乐路径，如 music/xxx.mp3；留空为无声"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "音量"
        },
        "trimBeforeSec": {
          "type": "number",
          "minimum": 0,
          "description": "从音乐第几秒开始"
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "src",
        "volume",
        "trimBeforeSec",
        "fadeInSec",
        "fadeOutSec"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "description": "帧率：预览 30，成片 60"
    },
    "format": {
      "description": "画幅，例如 16:9 或 9:16（由工程初始化时选择）",
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
    },
    "beatGrid": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "beats": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "beats"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pace": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.2,
      "description": "节奏：每页时长的倍数。1 为默认；1.2 让每页停留更久，全片随之变长"
    }
  },
  "required": [
    "couple",
    "photos",
    "copy",
    "music",
    "fps",
    "pace"
  ]
}
